# Copy this file to .env and fill in your actual values

# === Supabase Configuration ===
VITE_SUPABASE_PROJECT_ID="your_project_id_here"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key_here"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# === Google AdSense Configuration ===
# Get these from Google AdSense:
# - VITE_ADSENSE_CLIENT: Your Publisher ID (Account page in AdSense)
#   Format: ca-pub-1234567890123456
# - VITE_ADSENSE_SLOT: Your Ad Unit Slot ID (Ads page > By ad unit)
#   Format: 10-digit number like 9876543210

VITE_SPONSOR_ENABLED="true"
VITE_ADSENSE_CLIENT="ca-pub-YOUR_PUBLISHER_ID_HERE"
VITE_ADSENSE_SLOT="YOUR_SLOT_ID_HERE"

# Note: Never commit actual .env file with real credentials to GitHub
# Use .env.local for local development with real values
